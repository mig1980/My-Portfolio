# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Logo.dev API Token (required for company logos)
# Get your token at https://logo.dev
VITE_LOGO_DEV_TOKEN=

# Analytics (optional)
VITE_ANALYTICS_ID=

# Feature Flags (optional)
VITE_ENABLE_BLOG=false

# Résumé private build (npm run resume:build:private) - local only, never commit real values
RESUME_PHONE=
RESUME_OUTPUT_DIR=
